  "negative_patterns": [
    "(?:不要|别|別|勿|不用|无需|無需|不必|不想|不打算|不再|暂不|暫不|并不|並不|不是(?:在|要)?|不)(?:再|继续|繼續|给大家|給大家|给你们|給你們|给你|給你|向大家|向你|这样|這樣|刻意|特意|现在|現在|正在|进行|進行|去|来|來|把这个|把這個|把它|把这本|把這本){0,3}(?:展示|给.{0,3}看|給.{0,3}看|看这个|看這個|看看|看这里|看這裡)",
    "\\b(?:do\\s+not|don't|not)\\s+(?:show|look)\\b"
  ],
  "ending_patterns": [
    "(?:展示|演示|介绍|介紹|讲解|講解)(?:就|先)?到[这這][里裡](?:为止|為止)?(?:[了啦吧啊喔哦])?(?=[\\s，。！？,.!?；;]|$)",
    "(?:展示|演示|介绍|介紹|讲解|講解)(?:已经|已經|已)?(?:结束|結束|完毕|完畢|完了)",
    "\\b(?:that(?:'s|\\s+is)|this\\s+is)\\s+(?:all|it)\\s+for\\s+(?:today|now)\\b"
  ],
  "topic_change_patterns": [
    "换一个",
    "换下一个",
    "換一個",
    "換下一個",
    "先放下",
    "放到旁边",
    "放到旁邊",
    "\\b(?:next\\s+(?:item|object)|move\\s+on)\\b"
  ],
  "reference_patterns": [
    "这(?:个|是|一款|本|把|台|支|件|种|瓶|双|块)",
    "這(?:個|是|一款|本|把|台|支|件|種|瓶|雙|塊)",
    "\\bthis\\s+(?:is|one)\\b"
  ],
  "continuation_patterns": [
    "还没展示完",
